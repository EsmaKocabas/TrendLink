<div class="login-form login-form-left">
    <div class="agile-row">
        <h3>Yeni Cari Kayıt Formu</h3>
        @if (ViewBag.KayitHata != null)
        {
            <p style="color:red">@ViewBag.KayitHata</p>
        }
        @if (ViewBag.KayitBasarili != null)
        {
            <p style="color:green">@ViewBag.KayitBasarili</p>
        }
        <div class="login-agileits-top">
            @using (Html.BeginForm("partial1", "Login", FormMethod.Post, new { id = "cariRegisterForm" }))
            {
                <input type="text" class="name" name="CariAd" Placeholder="Adınız" required="" />
                <input type="text" class="name" name="CariSoyad" Placeholder="Soyadınız" required="" />
                <input type="text" class="name" name="CariSehir" Placeholder="Şehir" required="" />
                <input type="email" class="email" name="CariMail" Placeholder="Emailiniz" required="" />
                <input type="password" class="password" name="Sifre" Placeholder="Şifre" required="" />
                <div class="login-check">
                    <label class="checkbox">
                        <input type="checkbox" name="KurallariKabul">
                        <i> </i> Kuralları okudum &amp; kabul ediyorum.
                    </label>
                </div>
                <input type="submit" value="Kaydol">
            }
        </div>
    </div>
</div>